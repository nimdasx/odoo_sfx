<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_npm_server_list" model="ir.ui.view">
        <field name="name">z.npm.server.list</field>
        <field name="model">z.npm.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="email"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'error'"/>
                <field name="proxy_host_count"/>
                <field name="last_check"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_npm_server_form" model="ir.ui.view">
        <field name="name">z.npm.server.form</field>
        <field name="model">z.npm.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                        string="Test Connection" class="oe_highlight"
                        invisible="state == 'connected'"/>
                    <button name="action_test_connection" type="object"
                        string="Re-check Connection"
                        invisible="state != 'connected'"/>
                    <button name="action_sync_proxy_hosts" type="object"
                        string="Sync Proxy Hosts" class="oe_highlight"
                        invisible="state != 'connected'"/>
                    <button name="action_reset_draft" type="object"
                        string="Reset" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_proxy_hosts" type="object"
                            class="oe_stat_button" icon="fa-globe"
                            invisible="proxy_host_count == 0">
                            <field name="proxy_host_count" widget="statinfo" string="Proxy Hosts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Server Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="url" placeholder="http://192.168.0.13:81" widget="url"/>
                            <field name="verify_ssl"/>
                        </group>
                        <group string="Authentication">
                            <field name="email"/>
                            <field name="password" password="True"/>
                        </group>
                    </group>
                    <group string="Status">
                        <field name="last_check"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_npm_server_search" model="ir.ui.view">
        <field name="name">z.npm.server.search</field>
        <field name="model">z.npm.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <filter name="filter_connected" string="Connected"
                    domain="[('state', '=', 'connected')]"/>
                <filter name="filter_error" string="Error"
                    domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_npm_server" model="ir.actions.act_window">
        <field name="name">NPM Servers</field>
        <field name="res_model">z.npm.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_npm_server_search"/>
    </record>

</odoo>
